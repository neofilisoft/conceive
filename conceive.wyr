// ============================================================
//  conseive.wyr
// ============================================================

use std.json;
use std.yaml;

var seed = 1

fn rand() {
    seed = (seed * 1103515245 + 12345) % 2147483648
    if seed < 0 { seed = 0 - seed }
    return seed
}

fn rand_range(lo, hi) {
    return lo + (rand() % (hi - lo + 1))
}

fn roll_100() {
    return 1 + (rand() % 100)
}

// Pure-jitter seed (portable stand-in for random.seed(int(time.time())))
fn init_rng_from_jitter() {
    var s = 1
    var i = 0
    do {
        s = (s * 1664525 + 1013904223) % 2147483648
        if s < 0 { s = 0 - s }
        i = i + 1
    } til i >= 40000

    var j = 0
    var limit2 = 15000 + (s % 30000)
    do {
        s = (s * 1103515245 + 12345) % 2147483648
        if s < 0 { s = 0 - s }
        j = j + 1
    } til j >= limit2

    var k = 0
    do {
        s = (s * 214013 + 2531011) % 2147483648
        if s < 0 { s = 0 - s }
        k = k + 1
    } til k >= 5000

    seed = s
    if seed < 1 { seed = 1 }

    var w = 0
    do {
        rand()
        w = w + 1
    } til w >= 7

    print("RNG seeded from pure-jitter: " + str(seed))
}

// ---- breeding state ----
var last_combination = ""
var last_rate = 0
var last_pregnant = false
var last_roll = 0

fn calculate_pregnancy(race1, race2) {
    last_combination = "Breeding is not supported"
    last_rate = 0
    last_pregnant = false
    last_roll = 0

    if race1 == "human" and race2 == "human" {
        last_rate = rand_range(70, 90)
        last_combination = "human + human"
    } elif race1 == "elf" and race2 == "elf" {
        last_rate = rand_range(40, 50)
        last_combination = "elf + elf"
    } elif (race1 == "human" and race2 == "elf") or (race1 == "elf" and race2 == "human") {
        last_rate = rand_range(28, 45)
        last_combination = "human + elf"
    } else {
        return
    }

    last_roll = roll_100()
    if last_roll <= last_rate {
        last_pregnant = true
    }
}

fn show_result(race1, race2) {
    calculate_pregnancy(race1, race2)

    if last_combination == "Breeding is not supported" {
        print("miss " + last_combination)
        print("---")
        return
    }

    print(" breeding: " + last_combination)
    print(" successful rate: " + str(last_rate) + "%")
    print(" roll result: " + str(last_roll) + "/100")
    if last_pregnant {
        print("result: Conceive successfully")
    } else {
        print("result: Not conceive")
    }
    print("---")
}

// สร้าง child identity แล้วพิมพ์เป็น JSON + YAML
fn emit_child_identity(race1, race2, roll) {
    var potential = roll + rand_range(0 - 10, 10)
    if potential < 1 { potential = 1 }
    if potential > 100 { potential = 100 }

    var child_tail = 1000 + (rand() % 9000)
    var child_id = "child-" + str(child_tail) + str(rand() % 10000)
    var did = "did:soken:" + str(rand()) + str(rand() % 100000)

    var logic = 0.30 + (potential / 220.0)
    if logic > 1.0 { logic = 1.0 }
    var adapt = 0.35 + (potential / 250.0)
    if adapt > 1.0 { adapt = 1.0 }
    var stability = 1.0 - ((55 - potential) / 120.0)
    if stability < 0.0 { stability = 0.0 - stability }
    if stability < 0.1 { stability = 0.1 }
    if stability > 1.0 { stability = 1.0 }

    // ---- JSON object ----
    var root = json_object()
    json_set(root, "event_id", "conceive-" + str(rand() % 1000000000))
    json_set(root, "breeding", race1 + " + " + race2)
    json_set(root, "pregnancy_rate", last_rate)
    json_set(root, "roll_result", roll)
    json_set(root, "success", true)

    var child = json_object()
    json_set(child, "child_id", child_id)
    json_set(child, "did", did)
    json_set(child, "name", "SokenChild-" + str(child_tail))
    json_set(child, "archetype", "RNG-Hybrid")
    json_set(child, "potential", potential)

    var lineage = json_object()
    json_set(lineage, "parent_1", race1)
    json_set(lineage, "parent_2", race2)
    json_set(lineage, "breeding", race1 + " + " + race2)
    json_set(child, "lineage", lineage)

    var traits = json_object()
    json_set(traits, "logic", logic)
    json_set(traits, "adaptability", adapt)
    json_set(traits, "stability", stability)
    json_set(child, "base_traits", traits)

    json_set(child, "soul_signature", str(rand()) + str(rand()))
    json_set(root, "child_identity", child)

    print("")
    print("========== CHILD IDENTITY (JSON) ==========")
    print(json_pretty(root, 2))
    print("===========================================")
    print("")
    print("========== CHILD IDENTITY (YAML) ==========")
    print(yaml_encode(root))
    print("===========================================")
}

fn main() {
    init_rng_from_jitter()

    print("=== RNG Intercourse System (Wyrm) ===")
    print("")

    // 10 รอบสุ่มคู่
    var i = 1
    do {
        print("time number " + str(i) + ":")
        var t = rand_range(1, 3)
        if t == 1 {
            show_result("human", "human")
        } elif t == 2 {
            show_result("elf", "elf")
        } else {
            show_result("human", "elf")
        }
        i = i + 1
    } til i > 10

    // trials แบบ fixed
    print("=== trials (fixed) ===")
    show_result("human", "human")
    var human_ok = last_pregnant
    var human_roll = last_roll
    show_result("elf", "elf")
    show_result("human", "elf")

    // ถ้า human+human สำเร็จ > ออก identity เป็น JSON/YAML
    if human_ok {
        print("")
        print("One successful human+human conception detected.")
        emit_child_identity("human", "human", human_roll)
    } else {
        print("")
        print("No successful human+human conception in fixed trials.")
        print("(Re-run to try again — RNG changes each run)")
    }

    print("")
    print("Done.")
}