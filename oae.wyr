//  oae.wyr - OAE / Soken Digital Identity Generator 
// ============================================================

use std.json;
use std.yaml;
use std.random;
use std.time;

fn fmt3(x) {
    var n = int(x * 1000.0 + 0.5)
    var whole = n / 1000
    var frac = n % 1000
    if frac < 0 { frac = 0 - frac }
    var frac_s = str(frac)
    if frac < 10 {
        frac_s = "00" + frac_s
    } elif frac < 100 {
        frac_s = "0" + frac_s
    }
    return str(whole) + "." + frac_s
}

fn pick_archetype() {
    return rand_choice(["Analytic-Guardian", "Stoic-Strategist", "Curious-Explorer", "Empathic-Mediator", "Genesis-Hybrid"])
}

fn pick_persona() {
    return rand_choice(["Stoic-Analytic", "Balanced-Strategist", "Adaptive-Learner", "Resilient-Core"])
}

fn pick_region() {
    return rand_choice(["TH", "SEA", "GLOBAL", "LAB"])
}

fn emit_identity(seed_val) {
    var trust = 0.40 + rand() * 0.50
    var alignment = 0.50 + rand() * 0.45
    var curiosity = 0.30 + rand() * 0.60
    var discipline = 0.30 + rand() * 0.60
    var empathy = 0.20 + rand() * 0.60
    var volatility = 0.10 + rand() * 0.40
    var confidence = 0.40 + rand() * 0.50
    var learn_rate = 0.03 + rand() * 0.12
    var potential = rand_range(1, 100)

    var logic = 0.35 + (potential / 200.0)
    if logic > 1.0 { logic = 1.0 }
    var adapt = 0.30 + (potential / 250.0)
    if adapt > 1.0 { adapt = 1.0 }
    var stability = 1.0 - ((50 - potential) / 100.0)
    if stability < 0.0 { stability = 0.0 - stability }
    if stability < 0.1 { stability = 0.1 }
    if stability > 1.0 { stability = 1.0 }

    var did = "did:world:0x" + rand_bytes_hex(8)
    var token_id = "soken_" + rand_bytes_hex(6)
    var soul_sig = rand_bytes_hex(16)
    var prov_hash = rand_bytes_hex(16)
    var owner = "AetherLab:Node-" + str(rand_range(1, 99))
    var archetype = pick_archetype()
    var persona = pick_persona()
    var region = pick_region()
    var generation = rand_range(1, 12)
    var mutation = 0.005 + rand() * 0.03
    var base_seed = rand_bytes_hex(8)

    var arm_str = 10.0 + rand() * 15.0
    var arm_fat = rand() * 5.0
    var legs_str = 10.0 + rand() * 12.0
    var legs_fat = rand() * 4.0
    var mem_str = 20.0 + rand() * 30.0

    // JSON Object Building
    var root = json_object()
    json_set(root, "schema", "soken_identity_v1")
    json_set(root, "token_id", token_id)
    json_set(root, "soul_signature", soul_sig)
    json_set(root, "provenance_hash", prov_hash)
    json_set(root, "non_fungible", true)
    json_set(root, "unique_identity", true)
    json_set(root, "transferable", false)
    json_set(root, "merge_policy", "soul-consensus-v1")

    var identity = json_object()
    json_set(identity, "did", did)
    json_set(identity, "owner", owner)
    json_set(identity, "trust_score", trust)
    json_set(identity, "consent_level", 1.0)
    json_set(identity, "region", region)
    json_set(root, "identity", identity)

    var ddna = json_object()
    json_set(ddna, "archetype", archetype)
    json_set(ddna, "generation", generation)
    json_set(ddna, "mutation_rate", mutation)
    json_set(ddna, "base_seed", base_seed)

    var traits = json_object()
    json_set(traits, "logic", logic)
    json_set(traits, "empathy", empathy)
    json_set(traits, "curiosity", curiosity)
    json_set(traits, "discipline", discipline)
    json_set(ddna, "traits", traits)
    json_set(root, "ddna", ddna)

    var cognition = json_object()
    json_set(cognition, "persona", persona)
    json_set(cognition, "alignment", alignment)
    json_set(cognition, "curiosity", curiosity)
    json_set(cognition, "discipline", discipline)
    json_set(cognition, "empathy", empathy)
    json_set(cognition, "volatility", volatility)
    json_set(cognition, "confidence", confidence)
    json_set(cognition, "learning_rate", learn_rate)
    json_set(cognition, "affect_level", 0.0)
    json_set(root, "cognition", cognition)

    var digital_organs = json_object()
    var arm_right = json_object()
    json_set(arm_right, "schema", "motor_v2_power")
    json_set(arm_right, "volatile", true)
    json_set(arm_right, "strength", arm_str)
    json_set(arm_right, "fatigue", arm_fat)
    json_set(arm_right, "integrity", 100.0)
    json_set(digital_organs, "arm_right", arm_right)

    var legs = json_object()
    json_set(legs, "schema", "motor_v2_endurance")
    json_set(legs, "volatile", false)
    json_set(legs, "strength", legs_str)
    json_set(legs, "fatigue", legs_fat)
    json_set(legs, "integrity", 100.0)
    json_set(digital_organs, "legs", legs)

    var mem_core = json_object()
    json_set(mem_core, "schema", "cognitive_v1_memory")
    json_set(mem_core, "volatile", false)
    json_set(mem_core, "strength", mem_str)
    json_set(mem_core, "fatigue", 0.0)
    json_set(mem_core, "integrity", 100.0)
    json_set(digital_organs, "memory_core", mem_core)
    json_set(root, "digital_organs", digital_organs)

    var meta = json_object()
    json_set(meta, "potential", potential)
    json_set(meta, "rng_seed", seed_val)
    json_set(meta, "generated_by", "oae.wyr")
    json_set(root, "meta", meta)

    print("========== DIGITAL IDENTITY (JSON) ==========")
    print(json_pretty(root, 2))
    print("=============================================")
    print("")
    print("========== DIGITAL IDENTITY (YAML) ==========")
    print(yaml_encode(root))
    print("=============================================")
}

fn main() {
    var seed_val = 0
    if rand_has_trng() {
        rand_reseed_trng()
        seed_val = rand_secure_int(1000000, 9999999)
        print("RNG seeded via CPU Hardware TRNG (RDRAND)")
    } else {
        seed_val = int(time_unix_ms())
        rand_seed(seed_val)
        print("RNG seeded via high-precision timestamp")
    }

    print("OAE / Soken Digital Identity Generator")
    print("")

    emit_identity(seed_val)

    print("")
    print("Done. Generated valid JSON and YAML identity schemas.")
}